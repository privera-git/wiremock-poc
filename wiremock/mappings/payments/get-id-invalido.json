{
  "name": "GET /payments/{id}: formato de id inválido (400)",
  "priority": 8,
  "request": {
    "urlPathPattern": "/payments/[^/]+",
    "method": "GET"
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "code": "ID_INVALIDO",
      "error": "formato de identificador inválido (esperado xxxx-xxxx-xxxx, hexadecimal en minúsculas)"
    }
  }
}
