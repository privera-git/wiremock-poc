{
  "name": "Falla: límite de solicitudes (429)",
  "priority": 1,
  "request": {
    "urlPattern": "/.*",
    "method": "ANY",
    "headers": {
      "X-Mock-Fault": {
        "equalTo": "rate-limit-429"
      }
    }
  },
  "response": {
    "status": 429,
    "headers": {
      "Content-Type": "application/json",
      "Retry-After": "60"
    },
    "jsonBody": {
      "code": "LIMITE_EXCEDIDO",
      "error": "demasiadas solicitudes"
    }
  }
}
